{
  "name": "zestsend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8787",
    "dev:worker": "wrangler dev --local --port 8787 --env-file .env",
    "dev:without-turn": "wrangler dev --local --port 8787",
    "build": "tsc -b && vite build",
    "check": "tsc -b",
    "preview": "vite preview",
    "cf-typegen": "wrangler types",
    "deploy": "pnpm run build && wrangler deploy"
  },
  "dependencies": {
    "@number-flow/react": "^0.6.2",
    "@remixicon/react": "^4.9.0",
    "@tanstack/react-router": "^1.170.25",
    "clsx": "^2.1.1",
    "framer-motion": "^11.5.6",
    "hono": "^4.13.1",
    "lucide-react": "^1.31.0",
    "opentype.js": "^2.0.0",
    "overlayscrollbars": "^2.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.51.2",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "wrangler": "^4.120.1"
  }
}
